# Geo-Reason Environment Configuration
# Copy this file to .env and configure your settings

# Application Settings
DEBUG=false
LOG_LEVEL=INFO

# Model Settings
MODEL_NAME=meta-llama/Llama-3.2-3B-Instruct
MODEL_DEVICE=auto
MODEL_MAX_TOKENS=4096
MODEL_TEMPERATURE=0.1
USE_QUANTIZATION=true

# RAG Settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_PATH=./data/vector_store
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Sandbox Settings
SANDBOX_TIMEOUT=300
MAX_RETRIES=3
ENABLE_CODE_SANDBOXING=true

# Data Source Settings (Optional)
# BHOONIDHI_API_URL=https://api.bhoonidhi.example.com
# BHOONIDHI_API_KEY=your_api_key_here

# UI Settings
STREAMLIT_PORT=8501
MAP_DEFAULT_ZOOM=10
